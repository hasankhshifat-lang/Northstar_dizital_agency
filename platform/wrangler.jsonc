{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northstar-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/media/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "northstar-platform", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "northstar-platform-media" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_URL": "https://app.northstardizital.com" },
  "observability": { "enabled": true }
}
