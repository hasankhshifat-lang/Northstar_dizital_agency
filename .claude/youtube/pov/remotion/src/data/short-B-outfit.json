[{"start": 0.0, "end": 0.84, "text": "It's 1850.", "words": [{"w": " It's", "s": 0.0, "e": 0.16}, {"w": " 1850.", "s": 0.16, "e": 0.84}]}, {"start": 1.3, "end": 4.36, "text": "You have $300 and a 2,000 mile walk to Oregon.", "words": [{"w": " You", "s": 1.3, "e": 1.46}, {"w": " have", "s": 1.46, "e": 1.62}, {"w": " $300", "s": 1.62, "e": 2.06}, {"w": " and", "s": 2.06, "e": 2.66}, {"w": " a", "s": 2.66, "e": 2.8}, {"w": " 2", "s": 2.8, "e": 3.02}, {"w": ",000", "s": 3.02, "e": 3.36}, {"w": " mile", "s": 3.36, "e": 3.58}, {"w": " walk", "s": 3.58, "e": 3.9}, {"w": " to", "s": 3.9, "e": 4.06}, {"w": " Oregon.", "s": 4.06, "e": 4.36}]}, {"start": 4.92, "end": 6.28, "text": "Here's what you buy before you leave.", "words": [{"w": " Here's", "s": 4.92, "e": 5.16}, {"w": " what", "s": 5.16, "e": 5.26}, {"w": " you", "s": 5.26, "e": 5.36}, {"w": " buy", "s": 5.36, "e": 5.56}, {"w": " before", "s": 5.56, "e": 5.84}, {"w": " you", "s": 5.84, "e": 6.02}, {"w": " leave.", "s": 6.02, "e": 6.28}]}, {"start": 6.96, "end": 9.46, "text": "A guidebook from this year has a list for a family of three.", "words": [{"w": " A", "s": 6.96, "e": 7.06}, {"w": " guidebook", "s": 7.06, "e": 7.44}, {"w": " from", "s": 7.44, "e": 7.6}, {"w": " this", "s": 7.6, "e": 7.8}, {"w": " year", "s": 7.8, "e": 7.98}, {"w": " has", "s": 7.98, "e": 8.14}, {"w": " a", "s": 8.14, "e": 8.28}, {"w": " list", "s": 8.28, "e": 8.46}, {"w": " for", "s": 8.46, "e": 8.64}, {"w": " a", "s": 8.64, "e": 8.74}, {"w": " family", "s": 8.74, "e": 8.98}, {"w": " of", "s": 8.98, "e": 9.16}, {"w": " three.", "s": 9.16, "e": 9.46}]}, {"start": 9.9, "end": 11.92, "text": "Four yoke of oxen, that's eight animals,", "words": [{"w": " Four", "s": 9.9, "e": 10.1}, {"w": " yoke", "s": 10.1, "e": 10.38}, {"w": " of", "s": 10.38, "e": 10.48}, {"w": " oxen,", "s": 10.48, "e": 10.86}, {"w": " that's", "s": 11.16, "e": 11.36}, {"w": " eight", "s": 11.36, "e": 11.56}, {"w": " animals,", "s": 11.56, "e": 11.92}]}, {"start": 12.2, "end": 14.08, "text": "at $50 a yoke, $200.", "words": [{"w": " at", "s": 12.2, "e": 12.32}, {"w": " $50", "s": 12.32, "e": 12.7}, {"w": " a", "s": 12.7, "e": 13.12}, {"w": " yoke,", "s": 13.12, "e": 13.38}, {"w": " $200.", "s": 13.72, "e": 14.08}]}, {"start": 14.9, "end": 17.22, "text": "A wagon and its canvas cover, another 100.", "words": [{"w": " A", "s": 14.9, "e": 15.08}, {"w": " wagon", "s": 15.08, "e": 15.38}, {"w": " and", "s": 15.38, "e": 15.58}, {"w": " its", "s": 15.58, "e": 15.7}, {"w": " canvas", "s": 15.7, "e": 15.96}, {"w": " cover,", "s": 15.96, "e": 16.3}, {"w": " another", "s": 16.62, "e": 16.86}, {"w": " 100.", "s": 16.86, "e": 17.22}]}, {"start": 17.66, "end": 18.4, "text": "Then food.", "words": [{"w": " Then", "s": 17.66, "e": 17.98}, {"w": " food.", "s": 17.98, "e": 18.4}]}, {"start": 18.88, "end": 20.46, "text": "The rule people repeat in Letters Home", "words": [{"w": " The", "s": 18.88, "e": 18.98}, {"w": " rule", "s": 18.98, "e": 19.18}, {"w": " people", "s": 19.18, "e": 19.4}, {"w": " repeat", "s": 19.4, "e": 19.78}, {"w": " in", "s": 19.78, "e": 19.96}, {"w": " Letters", "s": 19.96, "e": 20.18}, {"w": " Home", "s": 20.18, "e": 20.46}]}, {"start": 20.46, "end": 22.68, "text": "is 200 pounds of flour per person.", "words": [{"w": " is", "s": 20.46, "e": 20.74}, {"w": " 200", "s": 20.74, "e": 21.08}, {"w": " pounds", "s": 21.08, "e": 21.48}, {"w": " of", "s": 21.48, "e": 21.68}, {"w": " flour", "s": 21.68, "e": 21.96}, {"w": " per", "s": 21.96, "e": 22.26}, {"w": " person.", "s": 22.26, "e": 22.68}]}, {"start": 23.02, "end": 25.32, "text": "For three of you, that's 600 pounds of flour", "words": [{"w": " For", "s": 23.02, "e": 23.18}, {"w": " three", "s": 23.18, "e": 23.42}, {"w": " of", "s": 23.42, "e": 23.54}, {"w": " you,", "s": 23.54, "e": 23.7}, {"w": " that's", "s": 23.88, "e": 24.12}, {"w": " 600", "s": 24.12, "e": 24.42}, {"w": " pounds", "s": 24.42, "e": 24.82}, {"w": " of", "s": 24.82, "e": 25.0}, {"w": " flour", "s": 25.0, "e": 25.32}]}, {"start": 25.32, "end": 27.16, "text": "before you've bought a single slab of bacon.", "words": [{"w": " before", "s": 25.32, "e": 25.56}, {"w": " you've", "s": 25.56, "e": 25.82}, {"w": " bought", "s": 25.82, "e": 25.94}, {"w": " a", "s": 25.94, "e": 26.1}, {"w": " single", "s": 26.1, "e": 26.4}, {"w": " slab", "s": 26.4, "e": 26.7}, {"w": " of", "s": 26.7, "e": 26.9}, {"w": " bacon.", "s": 26.9, "e": 27.16}]}, {"start": 27.68, "end": 28.58, "text": "Here's the first surprise.", "words": [{"w": " Here's", "s": 27.68, "e": 27.98}, {"w": " the", "s": 27.98, "e": 28.1}, {"w": " first", "s": 28.1, "e": 28.28}, {"w": " surprise.", "s": 28.28, "e": 28.58}]}, {"start": 29.14, "end": 30.18, "text": "You don't ride in the wagon.", "words": [{"w": " You", "s": 28.939999999999998, "e": 29.2}, {"w": " don't", "s": 29.2, "e": 29.42}, {"w": " ride", "s": 29.42, "e": 29.66}, {"w": " in", "s": 29.66, "e": 29.82}, {"w": " the", "s": 29.82, "e": 29.9}, {"w": " wagon.", "s": 29.9, "e": 30.18}]}, {"start": 30.58, "end": 30.96, "text": "It's full.", "words": [{"w": " It's", "s": 30.58, "e": 30.74}, {"w": " full.", "s": 30.74, "e": 30.96}]}, {"start": 31.38, "end": 33.44, "text": "You walk beside it every mile.", "words": [{"w": " You", "s": 31.38, "e": 31.48}, {"w": " walk", "s": 31.48, "e": 31.74}, {"w": " beside", "s": 31.74, "e": 32.1}, {"w": " it", "s": 32.1, "e": 32.38}, {"w": " every", "s": 32.38, "e": 32.98}, {"w": " mile.", "s": 32.98, "e": 33.44}]}]