[{"start": 0.0, "end": 3.26, "text": "You have until July 4th to reach one rock in what's now Wyoming.", "words": [{"w": " You", "s": 0.0, "e": 0.08}, {"w": " have", "s": 0.08, "e": 0.3}, {"w": " until", "s": 0.3, "e": 0.48}, {"w": " July", "s": 0.48, "e": 0.84}, {"w": " 4th", "s": 0.84, "e": 1.4}, {"w": " to", "s": 1.4, "e": 1.48}, {"w": " reach", "s": 1.48, "e": 1.64}, {"w": " one", "s": 1.64, "e": 1.94}, {"w": " rock", "s": 1.94, "e": 2.24}, {"w": " in", "s": 2.24, "e": 2.44}, {"w": " what's", "s": 2.44, "e": 2.7}, {"w": " now", "s": 2.7, "e": 2.86}, {"w": " Wyoming.", "s": 2.86, "e": 3.26}]}, {"start": 3.78, "end": 6.12, "text": "Miss it, and the winter could kill you before Oregon.", "words": [{"w": " Miss", "s": 3.78, "e": 4.0}, {"w": " it,", "s": 4.0, "e": 4.18}, {"w": " and", "s": 4.4, "e": 4.48}, {"w": " the", "s": 4.48, "e": 4.58}, {"w": " winter", "s": 4.58, "e": 4.8}, {"w": " could", "s": 4.8, "e": 5.0}, {"w": " kill", "s": 5.0, "e": 5.32}, {"w": " you", "s": 5.32, "e": 5.48}, {"w": " before", "s": 5.48, "e": 5.72}, {"w": " Oregon.", "s": 5.72, "e": 6.12}]}, {"start": 6.84, "end": 8.22, "text": "You leave in spring for a reason.", "words": [{"w": " You", "s": 6.84, "e": 7.02}, {"w": " leave", "s": 7.02, "e": 7.18}, {"w": " in", "s": 7.18, "e": 7.3}, {"w": " spring", "s": 7.3, "e": 7.58}, {"w": " for", "s": 7.58, "e": 7.84}, {"w": " a", "s": 7.84, "e": 7.94}, {"w": " reason.", "s": 7.94, "e": 8.22}]}, {"start": 8.58, "end": 10.82, "text": "Leave too early, and there's no grass for the oxen.", "words": [{"w": " Leave", "s": 8.58, "e": 8.76}, {"w": " too", "s": 8.76, "e": 8.94}, {"w": " early,", "s": 8.94, "e": 9.26}, {"w": " and", "s": 9.52, "e": 9.56}, {"w": " there's", "s": 9.56, "e": 9.72}, {"w": " no", "s": 9.72, "e": 9.84}, {"w": " grass", "s": 9.84, "e": 10.14}, {"w": " for", "s": 10.14, "e": 10.34}, {"w": " the", "s": 10.34, "e": 10.46}, {"w": " oxen.", "s": 10.46, "e": 10.82}]}, {"start": 11.14, "end": 13.4, "text": "Leave too late, and the snow catches you in the mountains.", "words": [{"w": " Leave", "s": 11.14, "e": 11.3}, {"w": " too", "s": 11.3, "e": 11.52}, {"w": " late,", "s": 11.52, "e": 11.8}, {"w": " and", "s": 12.08, "e": 12.12}, {"w": " the", "s": 12.12, "e": 12.24}, {"w": " snow", "s": 12.24, "e": 12.5}, {"w": " catches", "s": 12.5, "e": 12.86}, {"w": " you", "s": 12.86, "e": 13.02}, {"w": " in", "s": 13.02, "e": 13.1}, {"w": " the", "s": 13.1, "e": 13.16}, {"w": " mountains.", "s": 13.16, "e": 13.4}]}, {"start": 14.04, "end": 16.0, "text": "So the whole trail runs on one deadline.", "words": [{"w": " So", "s": 14.04, "e": 14.12}, {"w": " the", "s": 14.12, "e": 14.24}, {"w": " whole", "s": 14.24, "e": 14.46}, {"w": " trail", "s": 14.46, "e": 14.76}, {"w": " runs", "s": 14.76, "e": 15.12}, {"w": " on", "s": 15.12, "e": 15.32}, {"w": " one", "s": 15.32, "e": 15.64}, {"w": " deadline.", "s": 15.64, "e": 16.0}]}, {"start": 16.62, "end": 18.2, "text": "There's a rock in what will become Wyoming,", "words": [{"w": " There's", "s": 16.62, "e": 16.8}, {"w": " a", "s": 16.8, "e": 16.88}, {"w": " rock", "s": 16.88, "e": 17.16}, {"w": " in", "s": 17.16, "e": 17.3}, {"w": " what", "s": 17.3, "e": 17.4}, {"w": " will", "s": 17.4, "e": 17.5}, {"w": " become", "s": 17.5, "e": 17.76}, {"w": " Wyoming,", "s": 17.76, "e": 18.2}]}, {"start": 18.62, "end": 19.4, "text": "Independence Rock.", "words": [{"w": " Independence", "s": 18.62, "e": 19.0}, {"w": " Rock.", "s": 19.0, "e": 19.4}]}, {"start": 19.8, "end": 21.88, "text": "If you reach it by the 4th of July, you're on schedule.", "words": [{"w": " If", "s": 19.8, "e": 19.92}, {"w": " you", "s": 19.92, "e": 20.02}, {"w": " reach", "s": 20.02, "e": 20.24}, {"w": " it", "s": 20.24, "e": 20.34}, {"w": " by", "s": 20.34, "e": 20.44}, {"w": " the", "s": 20.44, "e": 20.54}, {"w": " 4th", "s": 20.54, "e": 20.8}, {"w": " of", "s": 20.8, "e": 20.82}, {"w": " July,", "s": 20.82, "e": 21.1}, {"w": " you're", "s": 21.4, "e": 21.56}, {"w": " on", "s": 21.56, "e": 21.66}, {"w": " schedule.", "s": 21.66, "e": 21.88}]}, {"start": 22.38, "end": 24.02, "text": "If you don't, you're racing the winter.", "words": [{"w": " If", "s": 22.38, "e": 22.54}, {"w": " you", "s": 22.54, "e": 22.66}, {"w": " don't,", "s": 22.66, "e": 23.0}, {"w": " you're", "s": 23.22, "e": 23.38}, {"w": " racing", "s": 23.38, "e": 23.66}, {"w": " the", "s": 23.66, "e": 23.82}, {"w": " winter.", "s": 23.82, "e": 24.02}]}]