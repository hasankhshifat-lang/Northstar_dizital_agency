[{"start": 0.0, "end": 1.72, "text": "What kills you first on the Oregon Trail?", "words": [{"w": " What", "s": 0.0, "e": 0.16}, {"w": " kills", "s": 0.16, "e": 0.36}, {"w": " you", "s": 0.36, "e": 0.54}, {"w": " first", "s": 0.54, "e": 0.84}, {"w": " on", "s": 0.84, "e": 1.06}, {"w": " the", "s": 1.06, "e": 1.16}, {"w": " Oregon", "s": 1.16, "e": 1.38}, {"w": " Trail?", "s": 1.38, "e": 1.72}]}, {"start": 2.2, "end": 3.7, "text": "Not snakes, not bandits,", "words": [{"w": " Not", "s": 2.2, "e": 2.42}, {"w": " snakes,", "s": 2.42, "e": 2.72}, {"w": " not", "s": 3.12, "e": 3.32}, {"w": " bandits,", "s": 3.32, "e": 3.7}]}, {"start": 4.04, "end": 5.74, "text": "but something you'll drink before breakfast.", "words": [{"w": " but", "s": 4.04, "e": 4.26}, {"w": " something", "s": 4.26, "e": 4.52}, {"w": " you'll", "s": 4.52, "e": 4.74}, {"w": " drink", "s": 4.74, "e": 5.04}, {"w": " before", "s": 5.04, "e": 5.32}, {"w": " breakfast.", "s": 5.32, "e": 5.74}]}, {"start": 6.54, "end": 8.0, "text": "It's spring, 1850.", "words": [{"w": " It's", "s": 6.54, "e": 6.76}, {"w": " spring,", "s": 6.76, "e": 7.0}, {"w": " 1850.", "s": 7.32, "e": 8.0}]}, {"start": 8.48, "end": 9.64, "text": "You're in Independence, Missouri,", "words": [{"w": " You're", "s": 8.48, "e": 8.62}, {"w": " in", "s": 8.62, "e": 8.7}, {"w": " Independence,", "s": 8.7, "e": 9.06}, {"w": " Missouri,", "s": 9.28, "e": 9.64}]}, {"start": 9.86, "end": 12.16, "text": "and you're about to walk 2,000 miles to Oregon.", "words": [{"w": " and", "s": 9.86, "e": 9.94}, {"w": " you're", "s": 9.94, "e": 10.06}, {"w": " about", "s": 10.06, "e": 10.22}, {"w": " to", "s": 10.22, "e": 10.4}, {"w": " walk", "s": 10.4, "e": 10.58}, {"w": " 2", "s": 10.58, "e": 10.9}, {"w": ",000", "s": 10.9, "e": 11.34}, {"w": " miles", "s": 11.34, "e": 11.62}, {"w": " to", "s": 11.62, "e": 11.86}, {"w": " Oregon.", "s": 11.86, "e": 12.16}]}, {"start": 12.64, "end": 13.58, "text": "You're not a real person.", "words": [{"w": " You're", "s": 12.64, "e": 12.78}, {"w": " not", "s": 12.78, "e": 12.9}, {"w": " a", "s": 12.9, "e": 13.02}, {"w": " real", "s": 13.02, "e": 13.18}, {"w": " person.", "s": 13.18, "e": 13.58}]}, {"start": 13.88, "end": 15.52, "text": "You're built from the diaries, guidebooks,", "words": [{"w": " You're", "s": 13.88, "e": 14.02}, {"w": " built", "s": 14.02, "e": 14.18}, {"w": " from", "s": 14.18, "e": 14.36}, {"w": " the", "s": 14.36, "e": 14.46}, {"w": " diaries,", "s": 14.46, "e": 14.86}, {"w": " guidebooks,", "s": 15.16, "e": 15.52}]}, {"start": 15.68, "end": 17.74, "text": "and records of the people who actually did this.", "words": [{"w": " and", "s": 15.68, "e": 15.8}, {"w": " records", "s": 15.8, "e": 16.1}, {"w": " of", "s": 16.1, "e": 16.34}, {"w": " the", "s": 16.34, "e": 16.42}, {"w": " people", "s": 16.42, "e": 16.62}, {"w": " who", "s": 16.62, "e": 16.82}, {"w": " actually", "s": 16.82, "e": 17.22}, {"w": " did", "s": 17.22, "e": 17.5}, {"w": " this.", "s": 17.5, "e": 17.74}]}, {"start": 18.16, "end": 20.24, "text": "Everything that happens to you happened to them.", "words": [{"w": " Everything", "s": 18.16, "e": 18.44}, {"w": " that", "s": 18.44, "e": 18.66}, {"w": " happens", "s": 18.66, "e": 18.92}, {"w": " to", "s": 18.92, "e": 19.12}, {"w": " you", "s": 19.12, "e": 19.36}, {"w": " happened", "s": 19.36, "e": 19.84}, {"w": " to", "s": 19.84, "e": 20.06}, {"w": " them.", "s": 20.06, "e": 20.24}]}, {"start": 20.68, "end": 21.52, "text": "You get 30 days.", "words": [{"w": " You", "s": 20.68, "e": 20.8}, {"w": " get", "s": 20.8, "e": 20.94}, {"w": " 30", "s": 20.94, "e": 21.22}, {"w": " days.", "s": 21.22, "e": 21.52}]}, {"start": 22.02, "end": 22.8, "text": "Let's see if you make it.", "words": [{"w": " Let's", "s": 22.02, "e": 22.2}, {"w": " see", "s": 22.2, "e": 22.3}, {"w": " if", "s": 22.3, "e": 22.4}, {"w": " you", "s": 22.4, "e": 22.5}, {"w": " make", "s": 22.5, "e": 22.66}, {"w": " it.", "s": 22.66, "e": 22.8}]}, {"start": 23.38, "end": 24.32, "text": "First, you shop.", "words": [{"w": " First,", "s": 23.38, "e": 23.62}, {"w": " you", "s": 23.98, "e": 24.06}, {"w": " shop.", "s": 24.06, "e": 24.32}]}, {"start": 24.78, "end": 26.28, "text": "A guidebook from this year has a list", "words": [{"w": " A", "s": 24.78, "e": 24.9}, {"w": " guidebook", "s": 24.9, "e": 25.26}, {"w": " from", "s": 25.26, "e": 25.44}, {"w": " this", "s": 25.44, "e": 25.62}, {"w": " year", "s": 25.62, "e": 25.82}, {"w": " has", "s": 25.82, "e": 25.98}, {"w": " a", "s": 25.98, "e": 26.12}, {"w": " list", "s": 26.12, "e": 26.28}]}, {"start": 26.28, "end": 27.3, "text": "for a family of three.", "words": [{"w": " for", "s": 26.28, "e": 26.46}, {"w": " a", "s": 26.46, "e": 26.62}, {"w": " family", "s": 26.62, "e": 26.82}, {"w": " of", "s": 26.82, "e": 27.0}, {"w": " three.", "s": 27.0, "e": 27.3}]}, {"start": 27.3, "end": 29.76, "text": "Four yoke of oxen, that's eight animals,", "words": [{"w": " Four", "s": 27.3, "e": 27.9}, {"w": " yoke", "s": 27.9, "e": 28.2}, {"w": " of", "s": 28.2, "e": 28.32}, {"w": " oxen,", "s": 28.32, "e": 28.72}, {"w": " that's", "s": 28.9, "e": 29.2}, {"w": " eight", "s": 29.2, "e": 29.38}, {"w": " animals,", "s": 29.38, "e": 29.76}]}, {"start": 30.02, "end": 31.88, "text": "at $50 a yoke, $200.", "words": [{"w": " at", "s": 30.02, "e": 30.16}, {"w": " $50", "s": 30.16, "e": 30.54}, {"w": " a", "s": 30.54, "e": 30.96}, {"w": " yoke,", "s": 30.96, "e": 31.24}, {"w": " $200.", "s": 31.56, "e": 31.88}]}, {"start": 32.74, "end": 35.06, "text": "A wagon and its canvas cover, another 100.", "words": [{"w": " A", "s": 32.74, "e": 32.92}, {"w": " wagon", "s": 32.92, "e": 33.22}, {"w": " and", "s": 33.22, "e": 33.42}, {"w": " its", "s": 33.42, "e": 33.54}, {"w": " canvas", "s": 33.54, "e": 33.8}, {"w": " cover,", "s": 33.8, "e": 34.14}, {"w": " another", "s": 34.46, "e": 34.7}, {"w": " 100.", "s": 34.7, "e": 35.06}]}, {"start": 35.52, "end": 36.24, "text": "Then food.", "words": [{"w": " Then", "s": 35.52, "e": 35.82}, {"w": " food.", "s": 35.82, "e": 36.24}]}, {"start": 36.72, "end": 38.32, "text": "The rule people repeat in letters home", "words": [{"w": " The", "s": 36.72, "e": 36.82}, {"w": " rule", "s": 36.82, "e": 37.02}, {"w": " people", "s": 37.02, "e": 37.24}, {"w": " repeat", "s": 37.24, "e": 37.62}, {"w": " in", "s": 37.62, "e": 37.78}, {"w": " letters", "s": 37.78, "e": 37.94}, {"w": " home", "s": 37.94, "e": 38.32}]}, {"start": 38.32, "end": 40.52, "text": "is 200 pounds of flour per person.", "words": [{"w": " is", "s": 38.32, "e": 38.58}, {"w": " 200", "s": 38.58, "e": 38.96}, {"w": " pounds", "s": 38.96, "e": 39.32}, {"w": " of", "s": 39.32, "e": 39.52}, {"w": " flour", "s": 39.52, "e": 39.8}, {"w": " per", "s": 39.8, "e": 40.1}, {"w": " person.", "s": 40.1, "e": 40.52}]}, {"start": 40.88, "end": 43.16, "text": "For three of you, that's 600 pounds of flour", "words": [{"w": " For", "s": 40.88, "e": 41.02}, {"w": " three", "s": 41.02, "e": 41.26}, {"w": " of", "s": 41.26, "e": 41.38}, {"w": " you,", "s": 41.38, "e": 41.54}, {"w": " that's", "s": 41.68, "e": 41.96}, {"w": " 600", "s": 41.96, "e": 42.26}, {"w": " pounds", "s": 42.26, "e": 42.66}, {"w": " of", "s": 42.66, "e": 42.82}, {"w": " flour", "s": 42.82, "e": 43.16}]}, {"start": 43.16, "end": 45.0, "text": "before you've bought a single slab of bacon.", "words": [{"w": " before", "s": 43.16, "e": 43.4}, {"w": " you've", "s": 43.4, "e": 43.66}, {"w": " bought", "s": 43.66, "e": 43.78}, {"w": " a", "s": 43.78, "e": 43.94}, {"w": " single", "s": 43.94, "e": 44.24}, {"w": " slab", "s": 44.24, "e": 44.54}, {"w": " of", "s": 44.54, "e": 44.72}, {"w": " bacon.", "s": 44.72, "e": 45.0}]}, {"start": 45.54, "end": 46.44, "text": "Here's the first surprise.", "words": [{"w": " Here's", "s": 45.54, "e": 45.82}, {"w": " the", "s": 45.82, "e": 45.92}, {"w": " first", "s": 45.92, "e": 46.12}, {"w": " surprise.", "s": 46.12, "e": 46.44}]}, {"start": 46.96, "end": 48.02, "text": "You don't ride in the wagon.", "words": [{"w": " You", "s": 46.96, "e": 47.06}, {"w": " don't", "s": 47.06, "e": 47.24}, {"w": " ride", "s": 47.24, "e": 47.5}, {"w": " in", "s": 47.5, "e": 47.66}, {"w": " the", "s": 47.66, "e": 47.74}, {"w": " wagon.", "s": 47.74, "e": 48.02}]}, {"start": 48.4, "end": 48.78, "text": "It's full.", "words": [{"w": " It's", "s": 48.4, "e": 48.58}, {"w": " full.", "s": 48.58, "e": 48.78}]}, {"start": 49.16, "end": 51.32, "text": "You walk beside it every mile.", "words": [{"w": " You", "s": 49.16, "e": 49.32}, {"w": " walk", "s": 49.32, "e": 49.58}, {"w": " beside", "s": 49.58, "e": 49.92}, {"w": " it", "s": 49.92, "e": 50.22}, {"w": " every", "s": 50.22, "e": 50.82}, {"w": " mile.", "s": 50.82, "e": 51.32}]}, {"start": 51.78, "end": 53.18, "text": "You leave in spring for a reason.", "words": [{"w": " You", "s": 51.78, "e": 51.96}, {"w": " leave", "s": 51.96, "e": 52.12}, {"w": " in", "s": 52.12, "e": 52.26}, {"w": " spring", "s": 52.26, "e": 52.5}, {"w": " for", "s": 52.5, "e": 52.78}, {"w": " a", "s": 52.78, "e": 52.92}, {"w": " reason.", "s": 52.92, "e": 53.18}]}, {"start": 53.48, "end": 55.8, "text": "Leave too early and there's no grass for the oxen.", "words": [{"w": " Leave", "s": 53.48, "e": 53.72}, {"w": " too", "s": 53.72, "e": 53.9}, {"w": " early", "s": 53.9, "e": 54.2}, {"w": " and", "s": 54.2, "e": 54.5}, {"w": " there's", "s": 54.5, "e": 54.66}, {"w": " no", "s": 54.66, "e": 54.8}, {"w": " grass", "s": 54.8, "e": 55.08}, {"w": " for", "s": 55.08, "e": 55.3}, {"w": " the", "s": 55.3, "e": 55.4}, {"w": " oxen.", "s": 55.4, "e": 55.8}]}, {"start": 55.8, "end": 58.36, "text": "Leave too late and the snow catches you in the mountains.", "words": [{"w": " Leave", "s": 55.8, "e": 56.26}, {"w": " too", "s": 56.26, "e": 56.46}, {"w": " late", "s": 56.46, "e": 56.76}, {"w": " and", "s": 56.76, "e": 57.08}, {"w": " the", "s": 57.08, "e": 57.18}, {"w": " snow", "s": 57.18, "e": 57.46}, {"w": " catches", "s": 57.46, "e": 57.82}, {"w": " you", "s": 57.82, "e": 57.96}, {"w": " in", "s": 57.96, "e": 58.06}, {"w": " the", "s": 58.06, "e": 58.12}, {"w": " mountains.", "s": 58.12, "e": 58.36}]}, {"start": 58.84, "end": 61.02, "text": "So the whole trail runs on one deadline.", "words": [{"w": " So", "s": 58.84, "e": 59.08}, {"w": " the", "s": 59.08, "e": 59.2}, {"w": " whole", "s": 59.2, "e": 59.42}, {"w": " trail", "s": 59.42, "e": 59.7}, {"w": " runs", "s": 59.7, "e": 60.06}, {"w": " on", "s": 60.06, "e": 60.28}, {"w": " one", "s": 60.28, "e": 60.6}, {"w": " deadline.", "s": 60.6, "e": 61.02}]}, {"start": 61.58, "end": 63.14, "text": "There's a rock in what will become Wyoming,", "words": [{"w": " There's", "s": 61.58, "e": 61.76}, {"w": " a", "s": 61.76, "e": 61.86}, {"w": " rock", "s": 61.86, "e": 62.12}, {"w": " in", "s": 62.12, "e": 62.24}, {"w": " what", "s": 62.24, "e": 62.36}, {"w": " will", "s": 62.36, "e": 62.46}, {"w": " become", "s": 62.46, "e": 62.72}, {"w": " Wyoming,", "s": 62.72, "e": 63.14}]}, {"start": 63.52, "end": 64.36, "text": "Independence Rock.", "words": [{"w": " Independence", "s": 63.52, "e": 63.88}, {"w": " Rock.", "s": 63.88, "e": 64.36}]}, {"start": 64.76, "end": 66.82, "text": "If you reach it by the 4th of July, you're on schedule.", "words": [{"w": " If", "s": 64.76, "e": 64.88}, {"w": " you", "s": 64.88, "e": 64.98}, {"w": " reach", "s": 64.98, "e": 65.18}, {"w": " it", "s": 65.18, "e": 65.3}, {"w": " by", "s": 65.3, "e": 65.38}, {"w": " the", "s": 65.38, "e": 65.5}, {"w": " 4th", "s": 65.5, "e": 65.74}, {"w": " of", "s": 65.74, "e": 65.8}, {"w": " July,", "s": 65.8, "e": 66.06}, {"w": " you're", "s": 66.34, "e": 66.5}, {"w": " on", "s": 66.5, "e": 66.62}, {"w": " schedule.", "s": 66.62, "e": 66.82}]}, {"start": 67.34, "end": 68.98, "text": "If you don't, you're racing the winter.", "words": [{"w": " If", "s": 67.34, "e": 67.48}, {"w": " you", "s": 67.48, "e": 67.6}, {"w": " don't,", "s": 67.6, "e": 67.96}, {"w": " you're", "s": 68.16, "e": 68.34}, {"w": " racing", "s": 68.34, "e": 68.62}, {"w": " the", "s": 68.62, "e": 68.78}, {"w": " winter.", "s": 68.78, "e": 68.98}]}, {"start": 69.58, "end": 72.4, "text": "Most days you'll make 10 to 15 miles on foot", "words": [{"w": " Most", "s": 69.58, "e": 69.78}, {"w": " days", "s": 69.78, "e": 70.02}, {"w": " you'll", "s": 70.02, "e": 70.24}, {"w": " make", "s": 70.24, "e": 70.36}, {"w": " 10", "s": 70.36, "e": 70.64}, {"w": " to", "s": 70.64, "e": 70.74}, {"w": " 15", "s": 70.74, "e": 71.04}, {"w": " miles", "s": 71.04, "e": 71.48}, {"w": " on", "s": 71.48, "e": 72.04}, {"w": " foot", "s": 72.04, "e": 72.4}]}, {"start": 72.4, "end": 73.74, "text": "at the pace of an ox.", "words": [{"w": " at", "s": 72.4, "e": 72.84}, {"w": " the", "s": 72.84, "e": 72.94}, {"w": " pace", "s": 72.94, "e": 73.2}, {"w": " of", "s": 73.2, "e": 73.34}, {"w": " an", "s": 73.34, "e": 73.44}, {"w": " ox.", "s": 73.44, "e": 73.74}]}, {"start": 74.34, "end": 75.42, "text": "Then the rivers start.", "words": [{"w": " Then", "s": 74.34, "e": 74.62}, {"w": " the", "s": 74.62, "e": 74.8}, {"w": " rivers", "s": 74.8, "e": 75.06}, {"w": " start.", "s": 75.06, "e": 75.42}]}, {"start": 75.9, "end": 78.08, "text": "Some have ferries, some you just have to cross.", "words": [{"w": " Some", "s": 75.9, "e": 76.1}, {"w": " have", "s": 76.1, "e": 76.28}, {"w": " ferries,", "s": 76.28, "e": 76.66}, {"w": " some", "s": 77.02, "e": 77.24}, {"w": " you", "s": 77.24, "e": 77.42}, {"w": " just", "s": 77.42, "e": 77.58}, {"w": " have", "s": 77.58, "e": 77.74}, {"w": " to", "s": 77.74, "e": 77.82}, {"w": " cross.", "s": 77.82, "e": 78.08}]}, {"start": 78.66, "end": 81.0, "text": "Out here, accidents are the second biggest killer.", "words": [{"w": " Out", "s": 78.66, "e": 78.8}, {"w": " here,", "s": 78.8, "e": 79.08}, {"w": " accidents", "s": 79.36, "e": 79.68}, {"w": " are", "s": 79.68, "e": 79.98}, {"w": " the", "s": 79.98, "e": 80.1}, {"w": " second", "s": 80.1, "e": 80.4}, {"w": " biggest", "s": 80.4, "e": 80.68}, {"w": " killer.", "s": 80.68, "e": 81.0}]}, {"start": 81.44, "end": 84.12, "text": "Wheels roll over people, guns go off by mistake,", "words": [{"w": " Wheels", "s": 81.44, "e": 81.72}, {"w": " roll", "s": 81.72, "e": 82.0}, {"w": " over", "s": 82.0, "e": 82.24}, {"w": " people,", "s": 82.24, "e": 82.52}, {"w": " guns", "s": 82.96, "e": 83.2}, {"w": " go", "s": 83.2, "e": 83.46}, {"w": " off", "s": 83.46, "e": 83.64}, {"w": " by", "s": 83.64, "e": 83.8}, {"w": " mistake,", "s": 83.8, "e": 84.12}]}, {"start": 84.64, "end": 87.18, "text": "and rivers drown people in front of their families", "words": [{"w": " and", "s": 84.44, "e": 84.7}, {"w": " rivers", "s": 84.7, "e": 85.0}, {"w": " drown", "s": 85.0, "e": 85.5}, {"w": " people", "s": 85.5, "e": 85.84}, {"w": " in", "s": 85.84, "e": 86.36}, {"w": " front", "s": 86.36, "e": 86.54}, {"w": " of", "s": 86.54, "e": 86.64}, {"w": " their", "s": 86.64, "e": 86.74}, {"w": " families", "s": 86.74, "e": 87.18}]}, {"start": 87.18, "end": 88.8, "text": "a few yards from the bank.", "words": [{"w": " a", "s": 87.18, "e": 87.66}, {"w": " few", "s": 87.66, "e": 87.88}, {"w": " yards", "s": 87.88, "e": 88.2}, {"w": " from", "s": 88.2, "e": 88.42}, {"w": " the", "s": 88.42, "e": 88.52}, {"w": " bank.", "s": 88.52, "e": 88.8}]}, {"start": 89.4, "end": 91.52, "text": "You get across, plenty of people don't.", "words": [{"w": " You", "s": 89.4, "e": 89.5}, {"w": " get", "s": 89.5, "e": 89.66}, {"w": " across,", "s": 89.66, "e": 89.98}, {"w": " plenty", "s": 90.44, "e": 90.74}, {"w": " of", "s": 90.74, "e": 90.88}, {"w": " people", "s": 90.88, "e": 91.06}, {"w": " don't.", "s": 91.06, "e": 91.52}]}, {"start": 91.78, "end": 93.74, "text": "And this still isn't the thing that kills you first.", "words": [{"w": " And", "s": 91.78, "e": 91.94}, {"w": " this", "s": 91.94, "e": 92.12}, {"w": " still", "s": 92.12, "e": 92.42}, {"w": " isn't", "s": 92.42, "e": 92.7}, {"w": " the", "s": 92.7, "e": 92.82}, {"w": " thing", "s": 92.82, "e": 92.98}, {"w": " that", "s": 92.98, "e": 93.1}, {"w": " kills", "s": 93.1, "e": 93.28}, {"w": " you", "s": 93.28, "e": 93.44}, {"w": " first.", "s": 93.44, "e": 93.74}]}, {"start": 94.48, "end": 96.9, "text": "By day 12, every day is the same day.", "words": [{"w": " By", "s": 94.48, "e": 94.5}, {"w": " day", "s": 94.5, "e": 94.7}, {"w": " 12,", "s": 94.7, "e": 95.02}, {"w": " every", "s": 95.34, "e": 95.66}, {"w": " day", "s": 95.66, "e": 95.94}, {"w": " is", "s": 95.94, "e": 96.18}, {"w": " the", "s": 96.18, "e": 96.32}, {"w": " same", "s": 96.32, "e": 96.64}, {"w": " day.", "s": 96.64, "e": 96.9}]}, {"start": 97.32, "end": 99.6, "text": "Up before light, yoke the oxen, walk.", "words": [{"w": " Up", "s": 97.32, "e": 97.42}, {"w": " before", "s": 97.42, "e": 97.72}, {"w": " light,", "s": 97.72, "e": 98.0}, {"w": " yoke", "s": 98.3, "e": 98.54}, {"w": " the", "s": 98.54, "e": 98.7}, {"w": " oxen,", "s": 98.7, "e": 99.08}, {"w": " walk.", "s": 99.34, "e": 99.6}]}, {"start": 100.04, "end": 101.32, "text": "Stop at noon, walk.", "words": [{"w": " Stop", "s": 100.04, "e": 100.24}, {"w": " at", "s": 100.24, "e": 100.42}, {"w": " noon,", "s": 100.42, "e": 100.62}, {"w": " walk.", "s": 101.0, "e": 101.32}]}, {"start": 101.84, "end": 104.2, "text": "Circle the wagons, cook, sleep on the ground.", "words": [{"w": " Circle", "s": 101.84, "e": 102.0}, {"w": " the", "s": 102.0, "e": 102.18}, {"w": " wagons,", "s": 102.18, "e": 102.56}, {"w": " cook,", "s": 102.84, "e": 103.06}, {"w": " sleep", "s": 103.52, "e": 103.68}, {"w": " on", "s": 103.68, "e": 103.86}, {"w": " the", "s": 103.86, "e": 103.94}, {"w": " ground.", "s": 103.94, "e": 104.2}]}, {"start": 104.66, "end": 107.36, "text": "Your boots are already going, your feet are worse.", "words": [{"w": " Your", "s": 104.66, "e": 104.76}, {"w": " boots", "s": 104.76, "e": 105.06}, {"w": " are", "s": 105.06, "e": 105.24}, {"w": " already", "s": 105.24, "e": 105.64}, {"w": " going,", "s": 105.64, "e": 105.96}, {"w": " your", "s": 106.38, "e": 106.48}, {"w": " feet", "s": 106.48, "e": 106.78}, {"w": " are", "s": 106.78, "e": 107.06}, {"w": " worse.", "s": 107.06, "e": 107.36}]}, {"start": 107.82, "end": 108.86, "text": "And the wagon in front of you", "words": [{"w": " And", "s": 107.82, "e": 107.96}, {"w": " the", "s": 107.96, "e": 108.04}, {"w": " wagon", "s": 108.04, "e": 108.28}, {"w": " in", "s": 108.28, "e": 108.44}, {"w": " front", "s": 108.44, "e": 108.62}, {"w": " of", "s": 108.62, "e": 108.72}, {"w": " you", "s": 108.72, "e": 108.86}]}, {"start": 108.86, "end": 110.08, "text": "has started leaving things behind,", "words": [{"w": " has", "s": 108.86, "e": 109.0}, {"w": " started", "s": 109.0, "e": 109.22}, {"w": " leaving", "s": 109.22, "e": 109.46}, {"w": " things", "s": 109.46, "e": 109.72}, {"w": " behind,", "s": 109.72, "e": 110.08}]}, {"start": 110.48, "end": 111.68, "text": "a dresser, a stove,", "words": [{"w": " a", "s": 110.48, "e": 110.64}, {"w": " dresser,", "s": 110.64, "e": 111.08}, {"w": " a", "s": 111.3, "e": 111.38}, {"w": " stove,", "s": 111.38, "e": 111.68}]}, {"start": 112.06, "end": 113.56, "text": "because the oxen can't pull it all.", "words": [{"w": " because", "s": 112.06, "e": 112.32}, {"w": " the", "s": 112.32, "e": 112.48}, {"w": " oxen", "s": 112.48, "e": 112.84}, {"w": " can't", "s": 112.84, "e": 113.14}, {"w": " pull", "s": 113.14, "e": 113.28}, {"w": " it", "s": 113.28, "e": 113.4}, {"w": " all.", "s": 113.4, "e": 113.56}]}, {"start": 113.56, "end": 114.88, "text": "You'll see a lot of that.", "words": [{"w": " You'll", "s": 113.56, "e": 114.14}, {"w": " see", "s": 114.14, "e": 114.3}, {"w": " a", "s": 114.3, "e": 114.42}, {"w": " lot", "s": 114.42, "e": 114.58}, {"w": " of", "s": 114.58, "e": 114.7}, {"w": " that.", "s": 114.7, "e": 114.88}]}, {"start": 115.32, "end": 117.44, "text": "People's whole lives left in the grass.", "words": [{"w": " People's", "s": 115.32, "e": 115.68}, {"w": " whole", "s": 115.68, "e": 115.92}, {"w": " lives", "s": 115.92, "e": 116.4}, {"w": " left", "s": 116.4, "e": 116.9}, {"w": " in", "s": 116.9, "e": 117.08}, {"w": " the", "s": 117.08, "e": 117.16}, {"w": " grass.", "s": 117.16, "e": 117.44}]}, {"start": 118.12, "end": 120.32, "text": "Day 19, the man in the next wagon", "words": [{"w": " Day", "s": 118.12, "e": 118.3}, {"w": " 19,", "s": 118.3, "e": 118.74}, {"w": " the", "s": 119.24, "e": 119.36}, {"w": " man", "s": 119.36, "e": 119.58}, {"w": " in", "s": 119.58, "e": 119.68}, {"w": " the", "s": 119.68, "e": 119.76}, {"w": " next", "s": 119.76, "e": 119.96}, {"w": " wagon", "s": 119.96, "e": 120.32}]}, {"start": 120.32, "end": 121.74, "text": "says he feels a little feverish.", "words": [{"w": " says", "s": 120.32, "e": 120.52}, {"w": " he", "s": 120.52, "e": 120.7}, {"w": " feels", "s": 120.7, "e": 120.9}, {"w": " a", "s": 120.9, "e": 121.04}, {"w": " little", "s": 121.04, "e": 121.16}, {"w": " feverish.", "s": 121.16, "e": 121.74}]}, {"start": 122.04, "end": 123.1, "text": "He's fine, he's eating.", "words": [{"w": " He's", "s": 122.04, "e": 122.2}, {"w": " fine,", "s": 122.2, "e": 122.42}, {"w": " he's", "s": 122.76, "e": 122.96}, {"w": " eating.", "s": 122.96, "e": 123.1}]}, {"start": 123.58, "end": 125.1, "text": "By noon, he can't stand up.", "words": [{"w": " By", "s": 123.58, "e": 123.7}, {"w": " noon,", "s": 123.7, "e": 123.96}, {"w": " he", "s": 124.28, "e": 124.4}, {"w": " can't", "s": 124.4, "e": 124.68}, {"w": " stand", "s": 124.68, "e": 124.84}, {"w": " up.", "s": 124.84, "e": 125.1}]}, {"start": 125.48, "end": 127.32, "text": "By evening, you're helping dig his grave.", "words": [{"w": " By", "s": 125.48, "e": 125.64}, {"w": " evening,", "s": 125.64, "e": 125.96}, {"w": " you're", "s": 126.32, "e": 126.44}, {"w": " helping", "s": 126.44, "e": 126.64}, {"w": " dig", "s": 126.64, "e": 126.86}, {"w": " his", "s": 126.86, "e": 127.04}, {"w": " grave.", "s": 127.04, "e": 127.32}]}, {"start": 127.86, "end": 128.66, "text": "That's cholera.", "words": [{"w": " That's", "s": 127.86, "e": 128.32}, {"w": " cholera.", "s": 128.32, "e": 128.66}]}, {"start": 129.08, "end": 130.9, "text": "The park service says victims often died", "words": [{"w": " The", "s": 129.08, "e": 129.2}, {"w": " park", "s": 129.2, "e": 129.38}, {"w": " service", "s": 129.38, "e": 129.74}, {"w": " says", "s": 129.74, "e": 129.98}, {"w": " victims", "s": 129.98, "e": 130.18}, {"w": " often", "s": 130.18, "e": 130.64}, {"w": " died", "s": 130.64, "e": 130.9}]}, {"start": 130.9, "end": 132.74, "text": "within 12 hours of the first symptoms.", "words": [{"w": " within", "s": 130.9, "e": 131.12}, {"w": " 12", "s": 131.12, "e": 131.52}, {"w": " hours", "s": 131.52, "e": 131.88}, {"w": " of", "s": 131.88, "e": 132.08}, {"w": " the", "s": 132.08, "e": 132.18}, {"w": " first", "s": 132.18, "e": 132.38}, {"w": " symptoms.", "s": 132.38, "e": 132.74}]}, {"start": 133.26, "end": 135.1, "text": "Healthy at breakfast, gone by supper.", "words": [{"w": " Healthy", "s": 133.26, "e": 133.48}, {"w": " at", "s": 133.48, "e": 133.64}, {"w": " breakfast,", "s": 133.64, "e": 133.88}, {"w": " gone", "s": 134.34, "e": 134.6}, {"w": " by", "s": 134.6, "e": 134.82}, {"w": " supper.", "s": 134.82, "e": 135.1}]}, {"start": 135.64, "end": 137.58, "text": "Here's the thing nobody on this trail knows yet.", "words": [{"w": " Here's", "s": 135.64, "e": 135.86}, {"w": " the", "s": 135.86, "e": 135.96}, {"w": " thing", "s": 135.96, "e": 136.16}, {"w": " nobody", "s": 136.16, "e": 136.48}, {"w": " on", "s": 136.48, "e": 136.74}, {"w": " this", "s": 136.74, "e": 136.88}, {"w": " trail", "s": 136.88, "e": 137.08}, {"w": " knows", "s": 137.08, "e": 137.34}, {"w": " yet.", "s": 137.34, "e": 137.58}]}, {"start": 137.96, "end": 139.54, "text": "Cholera lives in dirty water.", "words": [{"w": " Cholera", "s": 137.96, "e": 138.38}, {"w": " lives", "s": 138.38, "e": 138.72}, {"w": " in", "s": 138.72, "e": 138.9}, {"w": " dirty", "s": 138.9, "e": 139.16}, {"w": " water.", "s": 139.16, "e": 139.54}]}, {"start": 139.92, "end": 141.56, "text": "And thousands of people and animals", "words": [{"w": " And", "s": 139.92, "e": 140.06}, {"w": " thousands", "s": 140.06, "e": 140.48}, {"w": " of", "s": 140.48, "e": 140.72}, {"w": " people", "s": 140.72, "e": 140.98}, {"w": " and", "s": 140.98, "e": 141.22}, {"w": " animals", "s": 141.22, "e": 141.56}]}, {"start": 141.56, "end": 144.0, "text": "are using the same rivers, the same campsites,", "words": [{"w": " are", "s": 141.56, "e": 141.78}, {"w": " using", "s": 141.78, "e": 142.0}, {"w": " the", "s": 142.0, "e": 142.22}, {"w": " same", "s": 142.22, "e": 142.46}, {"w": " rivers,", "s": 142.46, "e": 142.74}, {"w": " the", "s": 143.08, "e": 143.18}, {"w": " same", "s": 143.18, "e": 143.44}, {"w": " campsites,", "s": 143.44, "e": 144.0}]}, {"start": 144.26, "end": 147.34, "text": "the same waterholes, one after another, all summer.", "words": [{"w": " the", "s": 144.26, "e": 144.34}, {"w": " same", "s": 144.34, "e": 144.6}, {"w": " waterholes,", "s": 144.6, "e": 145.16}, {"w": " one", "s": 145.44, "e": 145.7}, {"w": " after", "s": 145.7, "e": 146.06}, {"w": " another,", "s": 146.06, "e": 146.48}, {"w": " all", "s": 146.72, "e": 146.98}, {"w": " summer.", "s": 146.98, "e": 147.34}]}, {"start": 147.84, "end": 149.22, "text": "That cup you drank from on day one?", "words": [{"w": " That", "s": 147.84, "e": 147.96}, {"w": " cup", "s": 147.96, "e": 148.14}, {"w": " you", "s": 148.14, "e": 148.28}, {"w": " drank", "s": 148.28, "e": 148.48}, {"w": " from", "s": 148.48, "e": 148.66}, {"w": " on", "s": 148.66, "e": 148.82}, {"w": " day", "s": 148.82, "e": 148.96}, {"w": " one?", "s": 148.96, "e": 149.22}]}, {"start": 149.5, "end": 150.2, "text": "That's your answer.", "words": [{"w": " That's", "s": 149.5, "e": 149.84}, {"w": " your", "s": 149.84, "e": 149.94}, {"w": " answer.", "s": 149.94, "e": 150.2}]}, {"start": 150.6, "end": 152.94, "text": "Not snakes, not bandits, the water.", "words": [{"w": " Not", "s": 150.6, "e": 150.76}, {"w": " snakes,", "s": 150.76, "e": 151.06}, {"w": " not", "s": 151.48, "e": 151.62}, {"w": " bandits,", "s": 151.62, "e": 151.96}, {"w": " the", "s": 152.46, "e": 152.6}, {"w": " water.", "s": 152.6, "e": 152.94}]}, {"start": 153.48, "end": 155.26, "text": "Disease killed more people on this trail", "words": [{"w": " Disease", "s": 153.48, "e": 153.74}, {"w": " killed", "s": 153.74, "e": 154.14}, {"w": " more", "s": 154.14, "e": 154.38}, {"w": " people", "s": 154.38, "e": 154.66}, {"w": " on", "s": 154.66, "e": 154.84}, {"w": " this", "s": 154.84, "e": 155.02}, {"w": " trail", "s": 155.02, "e": 155.26}]}, {"start": 155.26, "end": 156.22, "text": "than anything else.", "words": [{"w": " than", "s": 155.26, "e": 155.44}, {"w": " anything", "s": 155.44, "e": 155.84}, {"w": " else.", "s": 155.84, "e": 156.22}]}, {"start": 156.62, "end": 157.62, "text": "Cholera, most of all.", "words": [{"w": " Cholera,", "s": 156.62, "e": 157.02}, {"w": " most", "s": 157.12, "e": 157.28}, {"w": " of", "s": 157.28, "e": 157.44}, {"w": " all.", "s": 157.44, "e": 157.62}]}, {"start": 158.06, "end": 159.56, "text": "Historians argue about the total.", "words": [{"w": " Historians", "s": 158.06, "e": 158.56}, {"w": " argue", "s": 158.56, "e": 158.88}, {"w": " about", "s": 158.88, "e": 159.14}, {"w": " the", "s": 159.14, "e": 159.3}, {"w": " total.", "s": 159.3, "e": 159.56}]}, {"start": 159.94, "end": 161.28, "text": "The National Park Service estimates", "words": [{"w": " The", "s": 159.94, "e": 160.02}, {"w": " National", "s": 160.02, "e": 160.28}, {"w": " Park", "s": 160.28, "e": 160.54}, {"w": " Service", "s": 160.54, "e": 160.88}, {"w": " estimates", "s": 160.88, "e": 161.28}]}, {"start": 161.28, "end": 164.28, "text": "that nearly one in 10 people who set out never made it.", "words": [{"w": " that", "s": 161.28, "e": 161.56}, {"w": " nearly", "s": 161.56, "e": 161.78}, {"w": " one", "s": 161.78, "e": 162.16}, {"w": " in", "s": 162.16, "e": 162.36}, {"w": " 10", "s": 162.36, "e": 162.58}, {"w": " people", "s": 162.58, "e": 162.94}, {"w": " who", "s": 162.94, "e": 163.14}, {"w": " set", "s": 163.14, "e": 163.34}, {"w": " out", "s": 163.34, "e": 163.54}, {"w": " never", "s": 163.54, "e": 163.92}, {"w": " made", "s": 163.92, "e": 164.18}, {"w": " it.", "s": 164.18, "e": 164.28}]}, {"start": 164.58, "end": 166.3, "text": "The Park Service's own math puts it", "words": [{"w": " The", "s": 164.58, "e": 164.7}, {"w": " Park", "s": 164.7, "e": 164.88}, {"w": " Service's", "s": 164.88, "e": 165.38}, {"w": " own", "s": 165.38, "e": 165.6}, {"w": " math", "s": 165.6, "e": 165.92}, {"w": " puts", "s": 165.92, "e": 166.16}, {"w": " it", "s": 166.16, "e": 166.3}]}, {"start": 166.3, "end": 169.12, "text": "at 10 to 15 deaths for every mile of trail.", "words": [{"w": " at", "s": 166.3, "e": 166.42}, {"w": " 10", "s": 166.42, "e": 166.68}, {"w": " to", "s": 166.68, "e": 166.84}, {"w": " 15", "s": 166.84, "e": 167.22}, {"w": " deaths", "s": 167.22, "e": 167.66}, {"w": " for", "s": 167.66, "e": 167.94}, {"w": " every", "s": 167.94, "e": 168.28}, {"w": " mile", "s": 168.28, "e": 168.66}, {"w": " of", "s": 168.66, "e": 168.84}, {"w": " trail.", "s": 168.84, "e": 169.12}]}, {"start": 169.72, "end": 171.24, "text": "Day 30, you're alive.", "words": [{"w": " Day", "s": 169.67999999999998, "e": 169.92}, {"w": " 30,", "s": 169.92, "e": 170.32}, {"w": " you're", "s": 170.78, "e": 170.98}, {"w": " alive.", "s": 170.98, "e": 171.24}]}, {"start": 171.76, "end": 173.76, "text": "You've walked maybe three or 400 miles.", "words": [{"w": " You've", "s": 171.76, "e": 171.94}, {"w": " walked", "s": 171.94, "e": 172.12}, {"w": " maybe", "s": 172.12, "e": 172.4}, {"w": " three", "s": 172.4, "e": 172.84}, {"w": " or", "s": 172.84, "e": 172.98}, {"w": " 400", "s": 172.98, "e": 173.34}, {"w": " miles.", "s": 173.34, "e": 173.76}]}, {"start": 174.28, "end": 176.64, "text": "That means you have more than 1,500 to go.", "words": [{"w": " That", "s": 174.28, "e": 174.38}, {"w": " means", "s": 174.38, "e": 174.58}, {"w": " you", "s": 174.58, "e": 174.78}, {"w": " have",