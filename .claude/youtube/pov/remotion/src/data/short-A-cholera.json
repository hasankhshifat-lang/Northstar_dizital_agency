[{"start": 0.0, "end": 1.12, "text": "You have 12 hours.", "words": [{"w": " You", "s": 0.0, "e": 0.12}, {"w": " have", "s": 0.12, "e": 0.3}, {"w": " 12", "s": 0.3, "e": 0.66}, {"w": " hours.", "s": 0.66, "e": 1.12}]}, {"start": 1.86, "end": 4.18, "text": "On the Oregon Trail, the thing that kills you most", "words": [{"w": " On", "s": 1.86, "e": 1.96}, {"w": " the", "s": 1.96, "e": 2.06}, {"w": " Oregon", "s": 2.06, "e": 2.32}, {"w": " Trail,", "s": 2.32, "e": 2.66}, {"w": " the", "s": 3.0, "e": 3.06}, {"w": " thing", "s": 3.06, "e": 3.26}, {"w": " that", "s": 3.26, "e": 3.4}, {"w": " kills", "s": 3.4, "e": 3.64}, {"w": " you", "s": 3.64, "e": 3.8}, {"w": " most", "s": 3.8, "e": 4.18}]}, {"start": 4.18, "end": 5.48, "text": "can take you before supper.", "words": [{"w": " can", "s": 4.18, "e": 4.46}, {"w": " take", "s": 4.46, "e": 4.72}, {"w": " you", "s": 4.72, "e": 4.88}, {"w": " before", "s": 4.88, "e": 5.16}, {"w": " supper.", "s": 5.16, "e": 5.48}]}, {"start": 6.02, "end": 6.44, "text": "What is it?", "words": [{"w": " What", "s": 6.02, "e": 6.14}, {"w": " is", "s": 6.14, "e": 6.3}, {"w": " it?", "s": 6.3, "e": 6.44}]}, {"start": 7.14, "end": 9.3, "text": "Day 19, the man in the next wagon", "words": [{"w": " Day", "s": 7.14, "e": 7.3}, {"w": " 19,", "s": 7.3, "e": 7.72}, {"w": " the", "s": 8.24, "e": 8.36}, {"w": " man", "s": 8.36, "e": 8.56}, {"w": " in", "s": 8.56, "e": 8.68}, {"w": " the", "s": 8.68, "e": 8.74}, {"w": " next", "s": 8.74, "e": 8.96}, {"w": " wagon", "s": 8.96, "e": 9.3}]}, {"start": 9.3, "end": 10.74, "text": "says he feels a little feverish.", "words": [{"w": " says", "s": 9.3, "e": 9.52}, {"w": " he", "s": 9.52, "e": 9.68}, {"w": " feels", "s": 9.68, "e": 9.9}, {"w": " a", "s": 9.9, "e": 10.02}, {"w": " little", "s": 10.02, "e": 10.14}, {"w": " feverish.", "s": 10.14, "e": 10.74}]}, {"start": 11.04, "end": 12.1, "text": "He's fine, he's eating.", "words": [{"w": " He's", "s": 11.04, "e": 11.2}, {"w": " fine,", "s": 11.2, "e": 11.42}, {"w": " he's", "s": 11.76, "e": 11.94}, {"w": " eating.", "s": 11.94, "e": 12.1}]}, {"start": 12.56, "end": 14.1, "text": "By noon, he can't stand up.", "words": [{"w": " By", "s": 12.56, "e": 12.7}, {"w": " noon,", "s": 12.7, "e": 12.96}, {"w": " he", "s": 13.28, "e": 13.4}, {"w": " can't", "s": 13.4, "e": 13.66}, {"w": " stand", "s": 13.66, "e": 13.84}, {"w": " up.", "s": 13.84, "e": 14.1}]}, {"start": 14.48, "end": 16.32, "text": "By evening, you're helping dig his grave.", "words": [{"w": " By", "s": 14.48, "e": 14.64}, {"w": " evening,", "s": 14.64, "e": 14.94}, {"w": " you're", "s": 15.26, "e": 15.42}, {"w": " helping", "s": 15.42, "e": 15.62}, {"w": " dig", "s": 15.62, "e": 15.84}, {"w": " his", "s": 15.84, "e": 16.04}, {"w": " grave.", "s": 16.04, "e": 16.32}]}, {"start": 16.88, "end": 17.66, "text": "That's cholera.", "words": [{"w": " That's", "s": 16.88, "e": 17.28}, {"w": " cholera.", "s": 17.28, "e": 17.66}]}, {"start": 18.08, "end": 19.88, "text": "The park service says victims often died", "words": [{"w": " The", "s": 18.08, "e": 18.2}, {"w": " park", "s": 18.2, "e": 18.38}, {"w": " service", "s": 18.38, "e": 18.74}, {"w": " says", "s": 18.74, "e": 18.96}, {"w": " victims", "s": 18.96, "e": 19.18}, {"w": " often", "s": 19.18, "e": 19.64}, {"w": " died", "s": 19.64, "e": 19.88}]}, {"start": 19.88, "end": 21.76, "text": "within 12 hours of the first symptoms.", "words": [{"w": " within", "s": 19.88, "e": 20.14}, {"w": " 12", "s": 20.14, "e": 20.52}, {"w": " hours", "s": 20.52, "e": 20.9}, {"w": " of", "s": 20.9, "e": 21.08}, {"w": " the", "s": 21.08, "e": 21.18}, {"w": " first", "s": 21.18, "e": 21.36}, {"w": " symptoms.", "s": 21.36, "e": 21.76}]}, {"start": 22.26, "end": 24.1, "text": "Healthy at breakfast, gone by supper.", "words": [{"w": " Healthy", "s": 22.26, "e": 22.48}, {"w": " at", "s": 22.48, "e": 22.64}, {"w": " breakfast,", "s": 22.64, "e": 22.88}, {"w": " gone", "s": 23.36, "e": 23.6}, {"w": " by", "s": 23.6, "e": 23.82}, {"w": " supper.", "s": 23.82, "e": 24.1}]}, {"start": 24.62, "end": 26.58, "text": "Here's the thing nobody on this trail knows yet.", "words": [{"w": " Here's", "s": 24.62, "e": 24.86}, {"w": " the", "s": 24.86, "e": 24.96}, {"w": " thing", "s": 24.96, "e": 25.14}, {"w": " nobody", "s": 25.14, "e": 25.48}, {"w": " on", "s": 25.48, "e": 25.72}, {"w": " this", "s": 25.72, "e": 25.88}, {"w": " trail", "s": 25.88, "e": 26.08}, {"w": " knows", "s": 26.08, "e": 26.32}, {"w": " yet.", "s": 26.32, "e": 26.58}]}, {"start": 27.0, "end": 28.54, "text": "Cholera lives in dirty water", "words": [{"w": " Cholera", "s": 27.0, "e": 27.38}, {"w": " lives", "s": 27.38, "e": 27.72}, {"w": " in", "s": 27.72, "e": 27.9}, {"w": " dirty", "s": 27.9, "e": 28.16}, {"w": " water", "s": 28.16, "e": 28.54}]}, {"start": 28.54, "end": 30.58, "text": "and thousands of people and animals", "words": [{"w": " and", "s": 28.54, "e": 29.02}, {"w": " thousands", "s": 29.02, "e": 29.48}, {"w": " of", "s": 29.48, "e": 29.7}, {"w": " people", "s": 29.7, "e": 29.98}, {"w": " and", "s": 29.98, "e": 30.22}, {"w": " animals", "s": 30.22, "e": 30.58}]}, {"start": 30.58, "end": 32.98, "text": "are using the same rivers, the same campsites,", "words": [{"w": " are", "s": 30.58, "e": 30.8}, {"w": " using", "s": 30.8, "e": 30.98}, {"w": " the", "s": 30.98, "e": 31.2}, {"w": " same", "s": 31.2, "e": 31.46}, {"w": " rivers,", "s": 31.46, "e": 31.72}, {"w": " the", "s": 32.08, "e": 32.14}, {"w": " same", "s": 32.14, "e": 32.42}, {"w": " campsites,", "s": 32.42, "e": 32.98}]}, {"start": 33.26, "end": 36.32, "text": "the same water holes, one after another, all summer.", "words": [{"w": " the", "s": 33.26, "e": 33.32}, {"w": " same", "s": 33.32, "e": 33.56}, {"w": " water", "s": 33.56, "e": 33.86}, {"w": " holes,", "s": 33.86, "e": 34.16}, {"w": " one", "s": 34.4, "e": 34.7}, {"w": " after", "s": 34.7, "e": 35.04}, {"w": " another,", "s": 35.04, "e": 35.42}, {"w": " all", "s": 35.74, "e": 35.98}, {"w": " summer.", "s": 35.98, "e": 36.32}]}, {"start": 36.82, "end": 39.1, "text": "Not snakes, not bandits, the water.", "words": [{"w": " Not", "s": 36.82, "e": 36.96}, {"w": " snakes,", "s": 36.96, "e": 37.26}, {"w": " not", "s": 37.7, "e": 37.8}, {"w": " bandits,", "s": 37.8, "e": 38.18}, {"w": " the", "s": 38.66, "e": 38.78}, {"w": " water.", "s": 38.78, "e": 39.1}]}]